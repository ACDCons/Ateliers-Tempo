# Modèle des variables. npm run setup le copie dans .env.local et .env.test.local
# et remplit les valeurs vides. Ne mettez jamais de vraie valeur dans ce fichier.

# Base : fichier SQLite local, lu par le pilote compatible Turso
DATABASE_URL=file:data/local.sqlite

# Secret de session Better Auth (généré par npm run setup)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Comptes fictifs (mots de passe générés par npm run setup)
ELLA_EMAIL=ella@ateliers-tempo.test
ELLA_PASSWORD=
YANIS_EMAIL=yanis@ateliers-tempo.test
YANIS_PASSWORD=
